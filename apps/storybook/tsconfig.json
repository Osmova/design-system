{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "preserve",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@ods-catalog/*": ["../../packages/quasar/catalog/*"],
      "@gallery/*": ["../gallery/src/*"]
    }
  },
  "include": [
    ".storybook/**/*.ts",
    "stories/**/*.ts",
    "demos/**/*.vue",
    "playwright.*.ts",
    "tests/**/*.ts",
    "../../packages/quasar/catalog/manifest.json",
    "../../packages/quasar/catalog/control.json"
  ]
}
