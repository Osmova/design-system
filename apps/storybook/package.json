{
  "name": "@osmova/ods-storybook",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Development-only Storybook component catalog for the design system. Not part of the published package.",
  "scripts": {
    "storybook": "pnpm -C ../.. build && storybook dev -p 6006 --host 127.0.0.1",
    "build-storybook": "pnpm -C ../.. build && storybook build --quiet",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test:smoke": "playwright test --config playwright.smoke.config.ts"
  },
  "dependencies": {
    "@osmova/ds-quasar": "workspace:*",
    "@phosphor-icons/vue": "^2.2.1",
    "@quasar/quasar-ui-qwindow": "^3.0.2",
    "quasar": "^2.35.0",
    "quasar-extras-svg-icons": "^3.4.0",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.3",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/outfit": "5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@fontsource-variable/red-hat-display": "5.3.0",
    "@fontsource-variable/sora": "5.3.0",
    "@playwright/test": "1.61.0",
    "@quasar/vite-plugin": "1.12.0",
    "@storybook/addon-a11y": "10.6.7",
    "@storybook/addon-docs": "10.6.7",
    "@storybook/vue3-vite": "10.6.7",
    "@types/node": "^24.19.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "sass": "^1.105.1",
    "storybook": "10.6.7",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vue-tsc": "^3.3.12"
  }
}
