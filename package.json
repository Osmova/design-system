{
  "name": "osmova-design-system",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "tokens": "pnpm -C packages/quasar tokens",
    "build": "pnpm -C packages/quasar build",
    "typecheck": "pnpm -C packages/quasar typecheck",
    "stories:sb": "pnpm -C apps/storybook storybook",
    "stories:sb:build": "pnpm -C apps/storybook build-storybook",
    "catalog:generate": "pnpm -C packages/quasar catalog:generate",
    "catalog:check": "pnpm -C packages/quasar catalog:check",
    "catalog:check:complete": "pnpm -C packages/quasar catalog:check:complete",
    "catalog:test": "pnpm -C packages/quasar catalog:test",
    "catalog:storybook": "pnpm -C apps/storybook storybook",
    "catalog:storybook:build": "pnpm -C apps/storybook build-storybook",
    "catalog:storybook:typecheck": "pnpm -C apps/storybook typecheck",
    "catalog:browser:test": "pnpm -C apps/storybook exec playwright test --config playwright.proof.config.ts",
    "gallery:dev": "pnpm -C apps/gallery dev",
    "gallery:build": "pnpm -C apps/gallery build",
    "gallery:test": "pnpm -C apps/gallery test:visual",
    "gallery:screens": "pnpm -C apps/gallery test:screens",
    "gallery:shadcn-reference:test": "pnpm -C apps/gallery exec playwright test --config playwright.shadcn-reference.config.ts",
    "shadcn-reference:build": "pnpm -C examples/shadcn-reference build",
    "shadcn-reference:check": "pnpm -C examples/shadcn-reference check:source && pnpm -C examples/shadcn-reference typecheck",
    "shadcn-reference:test": "pnpm shadcn-reference:build && pnpm -C examples/shadcn-reference test:reference",
    "test:runtime": "pnpm -C packages/quasar test:runtime",
    "test:runtime:ssr": "pnpm -C packages/quasar test:runtime:ssr",
    "test:tokens:parity": "pnpm -C packages/quasar test:tokens:parity",
    "css:budget": "pnpm -C packages/quasar css:budget",
    "pack:dry": "pnpm -C packages/quasar pack:dry",
    "verify:publish": "pnpm -C packages/quasar verify:publish",
    "rename:check": "node scripts/rename-prefix.mjs --check",
    "rename:parity": "node scripts/check-rename-parity.mjs",
    "changeset": "changeset"
  },
  "engines": {
    "node": ">=20.19 <27"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3"
  }
}
